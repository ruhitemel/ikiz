<Window x:Class="Ikiz.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:Ikiz.App.Controls"
        xmlns:conv="clr-namespace:Ikiz.App.Converters"
        xmlns:vm="clr-namespace:Ikiz.App.ViewModels"
        Title="İkiz — Hızlı Dosya Arama ve Çift Kopya Temizliği"
        Width="1320" Height="880" MinWidth="1040" MinHeight="620"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13.5"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        WindowStartupLocation="CenterScreen"
        Loaded="OnLoaded" Closing="OnClosing" PreviewKeyDown="OnPreviewKeyDown">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolVis"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolVis"/>
        <conv:InverseBoolConverter x:Key="InverseBool"/>
        <conv:EmptyToVisibilityConverter x:Key="EmptyVis"/>
        <conv:NotEmptyToVisibilityConverter x:Key="NotEmptyVis"/>

        <Style x:Key="TitleButton" TargetType="Button">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TitleHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseTitleButton" TargetType="Button" BasedOn="{StaticResource TitleButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CloseHoverBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GroupHeaderRoot" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="8,7"/>
            <Setter Property="Margin" Value="0,2"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource GroupHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="GroupHeaderTemplate" DataType="{x:Type vm:GroupHeaderVm}">
            <Border Style="{StaticResource GroupHeaderRoot}" Cursor="Hand" MouseLeftButtonUp="OnGroupHeaderClick">
                <Border.ContextMenu>
                    <ContextMenu Opened="OnGroupMenuOpened">
                        <MenuItem Tag="stage" Header="Tüm kopyaları panoya al" Click="OnMenuStageGroupClick">
                            <MenuItem.Icon>
                                <Path Data="{StaticResource GeoClipboardPlus}" Stroke="{DynamicResource MutedBrush}"
                                      StrokeThickness="1.4" Stretch="Uniform" StrokeLineJoin="Round"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Tag="rename" Header="Adı düzenle (tüm kopyalar)…" Click="OnMenuRenameGroupClick">
                            <MenuItem.Icon>
                                <Path Data="{StaticResource GeoPencil}" Stroke="{DynamicResource MutedBrush}"
                                      StrokeThickness="1.4" Stretch="Uniform" StrokeLineJoin="Round"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Tag="renameType" Header="Bu türdekileri toplu adlandır…" Click="OnMenuRenameGroupTypeClick"/>
                        <Separator/>
                        <MenuItem Tag="deleteOthers" Header="Tüm kopyaları sil… (1 kopya kalsın)" Click="OnMenuDeleteOthersGroupClick">
                            <MenuItem.Icon>
                                <Path Data="{StaticResource GeoTrash}" Stroke="{DynamicResource DangerSoftBrush}"
                                      StrokeThickness="1.4" Stretch="Uniform" StrokeLineJoin="Round"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Tag="delete" Header="Her kopyayı sil… (diskte hiç kalmaz)" Click="OnMenuDeleteGroupClick"/>
                        <Separator/>
                        <MenuItem Tag="undo" Header="Son silmeyi geri al" Click="OnMenuUndoClick">
                            <MenuItem.Icon>
                                <Path Data="{StaticResource GeoUndo}" Stroke="{DynamicResource MutedBrush}"
                                      StrokeThickness="1.4" Stretch="Uniform" StrokeLineJoin="Round"/>
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{Binding ChevronGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="11"
                               Foreground="{DynamicResource Muted2Brush}" VerticalAlignment="Center"
                               HorizontalAlignment="Center" ToolTip="{Binding ExpandTitle}"/>

                    <Grid Grid.Column="1" VerticalAlignment="Center">
                        <Border Width="30" Height="30" CornerRadius="8" Background="{Binding Color}" Opacity="0.16"/>
                        <TextBlock Text="{Binding ExtLabel}" Foreground="{Binding Color}" FontSize="9"
                                   FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>

                    <StackPanel Grid.Column="2" Margin="10,0,12,0" VerticalAlignment="Center">
                        <controls:HighlightText Content="{Binding Name}"
                                                Query="{Binding DataContext.SearchText, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Foreground="{DynamicResource TextBrush}"
                                                FontSize="14.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="{Binding CountText}" Foreground="{DynamicResource Muted2Brush}" FontSize="12"/>
                            <TextBlock Text=" · her biri " Foreground="{DynamicResource Muted2Brush}" FontSize="12"/>
                            <TextBlock Text="{Binding SizeText}" Foreground="{DynamicResource Muted2Brush}" FontSize="12"/>
                            <TextBlock Text=" · " Foreground="{DynamicResource Muted2Brush}" FontSize="12"/>
                            <TextBlock Text="{Binding PathHint}" Foreground="{DynamicResource Muted2Brush}"
                                       FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="420"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="{Binding WasteText}" Foreground="{DynamicResource AccentStrongBrush}"
                                   FontWeight="SemiBold" FontSize="12.5"/>
                        <TextBlock Text=" kazanılabilir" Foreground="{DynamicResource Muted2Brush}"
                                   FontSize="12" VerticalAlignment="Bottom" Margin="0,0,0,1"/>
                    </StackPanel>

                    <Button Grid.Column="4" Style="{StaticResource DangerGhostButton}" Tag="{Binding Key}"
                            Click="OnStageGroupClick" VerticalAlignment="Center"
                            AutomationProperties.Name="Panoya al"
                            ToolTip="Bu dosyanın tüm kopyalarını silme panosuna al">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource GeoTrash}" Stroke="{DynamicResource DangerSoftBrush}" StrokeThickness="1.3"
                                  Width="11" Height="11" Stretch="Uniform" StrokeLineJoin="Round" Margin="0,0,5,0"/>
                            <TextBlock Text="Panoya al"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="FileRowTemplate" DataType="{x:Type vm:FileRowVm}">
            <Border x:Name="RowRoot" Background="Transparent" CornerRadius="8" Padding="8,5" Margin="0,1"
                    MouseEnter="OnFileRowMouseEnter">
                <Border.ContextMenu>
                    <ContextMenu Opened="OnFileMenuOpened">
                        <MenuItem Tag="stage" Header="Panoya ekle" Click="OnMenuStageClick">
                            <MenuItem.Icon>
                                <Path Data="{StaticResource GeoClipboardPlus}" Stroke="{DynamicResource MutedBrush}"
                                      StrokeThickness="1.4" Stretch="Uniform" StrokeLineJoin="Round"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Tag="unstage" Header="Panodan çıkar" Click="OnMenuUnstageClick"/>
                        <Separator/>
                        <MenuItem Tag="rename" Header="Adı düzenle…" InputGestureText="F2" Click="OnMenuRenameClick">
                            <MenuItem.Icon>
                                <Path Data="{StaticResource GeoPencil}" Stroke="{DynamicResource MutedBrush}"
                                      StrokeThickness="1.4" Stretch="Uniform" StrokeLineJoin="Round"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Tag="renameType" Header="Bu türdekileri toplu adlandır…" Click="OnMenuRenameTypeClick"/>
                        <Separator/>
                        <MenuItem Tag="delete" Header="Sil… (yalnızca bu dosya)" InputGestureText="Del" Click="OnMenuDeleteClick">
                            <MenuItem.Icon>
                                <Path Data="{StaticResource GeoTrash}" Stroke="{DynamicResource DangerSoftBrush}"
                                      StrokeThickness="1.4" Stretch="Uniform" StrokeLineJoin="Round"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Tag="deleteOthers" Header="Tüm kopyaları sil… (bu dosya kalsın)" Click="OnMenuDeleteOthersClick"/>
                        <MenuItem Tag="deleteCopies" Header="Her kopyayı sil… (diskte hiç kalmaz)" Click="OnMenuDeleteCopiesClick"/>
                        <Separator/>
                        <MenuItem Tag="undo" Header="Son silmeyi geri al" Click="OnMenuUndoClick">
                            <MenuItem.Icon>
                                <Path Data="{StaticResource GeoUndo}" Stroke="{DynamicResource MutedBrush}"
                                      StrokeThickness="1.4" Stretch="Uniform" StrokeLineJoin="Round"/>
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44"/>
                        <ColumnDefinition Width="26"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <CheckBox Grid.Column="0" Style="{StaticResource DarkCheck}" HorizontalAlignment="Center"
                              VerticalAlignment="Center" IsChecked="{Binding IsPicked, Mode=TwoWay}"
                              Tag="{Binding}" Click="OnPickCheckClick"
                              AutomationProperties.Name="Dosyayı seç"
                              ToolTip="Toplu işlem için bu dosyayı seç"/>

                    <Grid Grid.Column="1" VerticalAlignment="Center">
                        <Border Width="22" Height="22" CornerRadius="6" Background="{Binding Color}" Opacity="0.12"/>
                        <TextBlock Text="{Binding ExtLabel}" Foreground="{Binding Color}" FontSize="8.5"
                                   FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>

                    <StackPanel Grid.Column="2" Margin="9,0,12,0" VerticalAlignment="Center">
                        <controls:HighlightText Content="{Binding Name}"
                                                Query="{Binding DataContext.SearchText, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Foreground="{DynamicResource TextBrush}"
                                                FontSize="14" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                        <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                            <TextBlock Text="{Binding Path}" Foreground="{DynamicResource Muted2Brush}"
                                       FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="560"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                        <Border Background="{DynamicResource ElevatedBrush}" CornerRadius="5" Padding="5,1" Margin="0,0,8,0"
                                Visibility="{Binding ShowCopy, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="{Binding CopyText}" Foreground="{DynamicResource Muted2Brush}"
                                       FontFamily="Cascadia Mono, Consolas" FontSize="11"/>
                        </Border>
                        <TextBlock Text="{Binding SizeText}" Foreground="{DynamicResource MutedBrush}"
                                   FontFamily="Cascadia Mono, Consolas" FontSize="11.5"/>
                    </StackPanel>

                    <Button Grid.Column="4" Style="{StaticResource IconButton}" Width="26" Height="26"
                            Tag="{Binding}" Click="OnTrashRowClick" VerticalAlignment="Center"
                            AutomationProperties.Name="Panoya al"
                            ToolTip="Tüm kopyaları silme panosuna al">
                        <Path Data="{StaticResource GeoTrash}" Stroke="{DynamicResource Muted2Brush}" StrokeThickness="1.3"
                              Width="13" Height="13" Stretch="Uniform" StrokeLineJoin="Round"/>
                    </Button>
                </Grid>
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource RowHoverBrush}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>
        </DataTemplate>

        <controls:ResultTemplateSelector x:Key="ResultSelector"
                                         GroupTemplate="{StaticResource GroupHeaderTemplate}"
                                         FileTemplate="{StaticResource FileRowTemplate}"/>

        <Style x:Key="ResultItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="BoardRowTemplate" DataType="{x:Type vm:BoardRowVm}">
            <Grid Margin="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="30"/>
                </Grid.ColumnDefinitions>
                <CheckBox Style="{StaticResource DarkCheck}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                          VerticalAlignment="Center" HorizontalAlignment="Center" Margin="9,0,0,0"/>
                <StackPanel Grid.Column="1" Background="Transparent" Margin="4,8,6,8" Cursor="Hand"
                            MouseLeftButtonUp="OnBoardRowMainClick">
                    <TextBlock Text="{Binding Name}" FontSize="13.5" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Path}" Foreground="{DynamicResource Muted2Brush}" FontSize="11.5"
                               TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                    <TextBlock Text="{Binding SizeText}" Foreground="{DynamicResource Muted2Brush}"
                               FontFamily="Cascadia Mono, Consolas" FontSize="11"/>
                    <Border Background="{DynamicResource KeptBadgeBrush}" CornerRadius="5" Padding="5,1" Margin="7,0,0,0"
                            Visibility="{Binding IsKept, Converter={StaticResource BoolVis}}">
                        <TextBlock Text="Korunacak" Foreground="{DynamicResource InfoStrongBrush}" FontSize="11"/>
                    </Border>
                </StackPanel>
                <Button Grid.Column="3" Style="{StaticResource IconButton}" Width="24" Height="24"
                        Tag="{Binding}" Click="OnUnstageClick" VerticalAlignment="Center"
                        AutomationProperties.Name="Panodan çıkar"
                        ToolTip="Panodan çıkar">
                    <Path Data="{StaticResource GeoClose}" Stroke="{DynamicResource Muted2Brush}" StrokeThickness="1.5"
                          Width="9" Height="9" Stretch="Uniform"/>
                </Button>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="BoardGroupTemplate" DataType="{x:Type vm:BoardGroupVm}">
            <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="10"
                    Background="{DynamicResource SurfaceBrush}" Margin="0,0,0,9">
                <StackPanel>
                    <Border Background="{DynamicResource Panel2Brush}" CornerRadius="9,9,0,0" Padding="8,7"
                            BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid VerticalAlignment="Center">
                                <Border Width="22" Height="22" CornerRadius="6" Background="{Binding Color}" Opacity="0.15"/>
                                <TextBlock Text="{Binding ExtLabel}" Foreground="{Binding Color}" FontSize="8.5"
                                           FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <StackPanel Grid.Column="1" Margin="7,0,6,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"/>
                                <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                    <TextBlock Text="{Binding CopyBadge}" FontSize="11.5" Foreground="{DynamicResource Muted2Brush}"/>
                                    <TextBlock Text=" · " FontSize="11" Foreground="{DynamicResource Muted2Brush}"/>
                                    <TextBlock Text="{Binding Meta}" FontSize="11.5" Foreground="{DynamicResource Muted2Brush}"/>
                                </StackPanel>
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource LinkButton}" Tag="{Binding}"
                                    Click="OnKeepOneClick" Margin="0,0,6,0" VerticalAlignment="Center"
                                    AutomationProperties.Name="Bir kopyayı koru"
                                    Foreground="{DynamicResource AccentStrongBrush}" FontSize="11"
                                    Visibility="{Binding CanKeepOne, Converter={StaticResource BoolVis}}"
                                    ToolTip="Bir kopyayı koru, diğerlerini seç">
                                <TextBlock Text="1 koru"/>
                            </Button>
                            <Border Grid.Column="3" Background="{DynamicResource DangerGhostHoverBrush}" CornerRadius="5" Padding="5,1"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding IsFullGroup, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="tüm kopyalar" Foreground="{DynamicResource DangerSoftBrush}" FontSize="10.5"/>
                            </Border>
                        </Grid>
                    </Border>

                    <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource BoardRowTemplate}"/>

                    <Border Background="{DynamicResource DangerSurfaceBrush}" CornerRadius="0,0,9,9" Padding="9,6"
                            BorderBrush="{DynamicResource DangerBorderBrush}" BorderThickness="0,1,0,0"
                            Visibility="{Binding IsFullGroup, Converter={StaticResource BoolVis}}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource GeoWarning}" Stroke="{DynamicResource DangerSoftBrush}"
                                  StrokeThickness="1.4" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0"/>
                            <TextBlock Text="Bu grubun tüm kopyaları seçili — dosya tamamen silinecek."
                                       Foreground="{DynamicResource DangerSoftBrush}" FontSize="11" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="42"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Başlık çubuğu -->
        <Border Grid.Row="0" Background="{DynamicResource TitleBarBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                    <Grid Width="24" Height="24" Margin="0,0,9,0">
                        <Border Width="16" Height="16" CornerRadius="4" Background="{DynamicResource AccentBrush}"
                                HorizontalAlignment="Left" VerticalAlignment="Top"/>
                        <Border Width="16" Height="16" CornerRadius="4" Background="{DynamicResource LogoSecondBrush}"
                                BorderBrush="{DynamicResource TitleBarBrush}" BorderThickness="2"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                    </Grid>
                    <TextBlock Text="İkiz" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="5" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="WINDOWS" FontSize="10" Foreground="{DynamicResource InfoStrongBrush}" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Border Background="{DynamicResource StatusSurfaceBrush}" BorderBrush="{DynamicResource StatusBorderBrush}" BorderThickness="1" CornerRadius="999"
                            Padding="8,3" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="{DynamicResource GoodBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding IndexStatus}" FontSize="11" Foreground="{DynamicResource InfoTextBrush}" MaxWidth="230"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Button Style="{StaticResource GhostButton}" Click="OnOpenBoardClick" Margin="0,0,8,0"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            ToolTip="Bekleyen silme işlemlerini aç"
                            AutomationProperties.Name="Panoyu göster">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource GeoClipboard}" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.3"
                                  Width="12" Height="12" Stretch="Uniform" StrokeLineJoin="Round" Margin="0,0,6,0"/>
                            <TextBlock Text="Panoyu göster" VerticalAlignment="Center"/>
                            <Border Background="{DynamicResource CountBadgeBrush}" CornerRadius="999" Padding="5,0" Margin="7,0,0,0"
                                    Visibility="{Binding HasQueue, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="{Binding QueueCount}" FontSize="11" FontWeight="Bold"
                                           Foreground="{DynamicResource CountBadgeTextBrush}" FontFamily="Cascadia Mono, Consolas"/>
                            </Border>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource GhostButton}" Click="OnOpenLocationsClick" Margin="0,0,8,0"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Sürücü veya klasör ekle"
                            AutomationProperties.Name="Konum ekle">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource GeoFolder}" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.3"
                                  Width="12" Height="12" Stretch="Uniform" StrokeLineJoin="Round" Margin="0,0,6,0"/>
                            <TextBlock Text="Konum ekle"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource GhostButton}" Click="OnReindexClick"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Tüm klasörleri yeniden tara">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource GeoRefresh}" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.3"
                                  Width="12" Height="12" Stretch="Uniform" StrokeLineJoin="Round" Margin="0,0,6,0"/>
                            <TextBlock Text="Yeniden indeksle"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <Button Style="{StaticResource IconButton}" Width="30" Height="30" Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Click="OnAboutClick"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            AutomationProperties.Name="Hakkında ve güncellemeler"
                            ToolTip="Hakkında ve güncellemeler">
                        <Grid Width="16" Height="16">
                            <Path Data="{StaticResource GeoInfo}" Stroke="{DynamicResource MutedBrush}"
                                  StrokeThickness="1.5" Stretch="Uniform" StrokeLineJoin="Round"/>
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentBrush}"
                                     HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-2,0"
                                     Visibility="{Binding UpdateBadge, Converter={StaticResource BoolVis}}"/>
                        </Grid>
                    </Button>
                    <Border Background="{DynamicResource Panel3Brush}" CornerRadius="8" Padding="2"
                            Margin="0,0,10,0" VerticalAlignment="Center"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            ToolTip="Açık veya koyu tema seç">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource ThemeSegment}" GroupName="theme"
                                         IsChecked="{Binding IsLightTheme, Mode=TwoWay}" ToolTip="Açık tema"
                                         AutomationProperties.Name="Açık tema"
                                         shell:WindowChrome.IsHitTestVisibleInChrome="True">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource GeoSun}" Stroke="{DynamicResource MutedBrush}"
                                          StrokeThickness="1.5" Width="11" Height="11" Stretch="Uniform"
                                          StrokeLineJoin="Round"/>
                                    <TextBlock Text="Açık" Margin="5,0,0,0"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource ThemeSegment}" GroupName="theme"
                                         IsChecked="{Binding IsDarkTheme, Mode=TwoWay}" ToolTip="Koyu tema"
                                         AutomationProperties.Name="Koyu tema"
                                         shell:WindowChrome.IsHitTestVisibleInChrome="True">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource GeoMoon}" Stroke="{DynamicResource MutedBrush}"
                                          StrokeThickness="1.5" Width="11" Height="11" Stretch="Uniform"
                                          StrokeLineJoin="Round"/>
                                    <TextBlock Text="Koyu" Margin="5,0,0,0"/>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </Border>
                    <Button Style="{StaticResource TitleButton}" Click="OnMinimizeClick"
                            AutomationProperties.Name="Simge durumuna küçült"
                            ToolTip="Simge durumuna küçült">
                        <Path Data="{StaticResource GeoMinus}" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.2"
                              Width="10" Height="10" Stretch="Uniform"/>
                    </Button>
                    <Button Style="{StaticResource TitleButton}" Click="OnMaximizeClick"
                            AutomationProperties.Name="Büyüt veya geri yükle"
                            ToolTip="Büyüt veya geri yükle">
                        <Path Data="{StaticResource GeoMaximize}" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.2"
                              Width="9" Height="9" Stretch="Uniform"/>
                    </Button>
                    <Button Style="{StaticResource CloseTitleButton}" Click="OnCloseClick"
                            AutomationProperties.Name="Kapat"
                            ToolTip="Kapat">
                        <Path Data="{StaticResource GeoClose}" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.2"
                              Width="10" Height="10" Stretch="Uniform"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Arama -->
        <Grid Grid.Row="1" Margin="14,12,14,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="SearchBorder" Height="48" CornerRadius="12" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Padding="14,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource FocusBorderBrush}"/>
                                <Setter Property="Background" Value="{DynamicResource SurfaceFocusBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource ControlHoverBorderBrush}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Path Data="{StaticResource GeoSearch}" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.7"
                          Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center"/>
                    <Grid Grid.Column="1" Margin="8,0,10,0">
                        <TextBox x:Name="SearchBox" Style="{StaticResource SearchInput}"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Dosya ara"
                                 VerticalAlignment="Center"/>
                        <TextBlock Text="dosya adı, uzantı veya yol ara…  örn. fatura"
                                   Foreground="{DynamicResource Muted2Brush}" FontSize="16" VerticalAlignment="Center"
                                   IsHitTestVisible="False" Margin="2,0,0,0"
                                   Visibility="{Binding SearchText, Converter={StaticResource EmptyVis}}"/>
                    </Grid>
                    <Border Grid.Column="2" Background="{DynamicResource Panel2Brush}" BorderBrush="{DynamicResource LineBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="6,2" VerticalAlignment="Center">
                        <TextBlock Text="Ctrl K" FontFamily="Cascadia Mono, Consolas" FontSize="11"
                                   Foreground="{DynamicResource Muted2Brush}"/>
                    </Border>
                </Grid>
            </Border>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,2,0">
                <StackPanel Margin="0,0,22,0">
                    <TextBlock Text="{Binding ResultSummary}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                    <TextBlock Text="canlı arama" Foreground="{DynamicResource Muted2Brush}" FontSize="11"
                               HorizontalAlignment="Right" Margin="0,1,0,0"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="{Binding ElapsedText}" FontFamily="Cascadia Mono, Consolas" FontSize="13"
                               Foreground="{DynamicResource AccentStrongBrush}" HorizontalAlignment="Right"/>
                    <TextBlock Text="sorgu süresi" Foreground="{DynamicResource Muted2Brush}" FontSize="11"
                               HorizontalAlignment="Right" Margin="0,1,0,0"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Tür filtreleri ve seçenekler -->
        <Grid Grid.Row="2" Margin="14,0,14,9">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ListBox x:Name="TypeList" ItemsSource="{Binding Types}" SelectedItem="{Binding SelectedType, Mode=TwoWay}"
                     ItemContainerStyle="{StaticResource ChipItem}" Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                     VerticalAlignment="Center">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                            <Border Background="{DynamicResource BadgeBrush}" CornerRadius="6" Padding="4,0" Margin="5,0,0,0">
                                <TextBlock Text="{Binding CountText}" FontFamily="Cascadia Mono, Consolas"
                                           FontSize="11" Foreground="{DynamicResource Muted2Brush}"/>
                            </Border>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Sırala" Foreground="{DynamicResource Muted2Brush}" FontSize="11.5"
                           VerticalAlignment="Center" Margin="0,0,7,0"/>
                <ComboBox Style="{StaticResource DarkCombo}" Width="162" ItemsSource="{Binding SortOptions}"
                          SelectedItem="{Binding SelectedSort, Mode=TwoWay}" Margin="0,0,16,0"/>
                <CheckBox Style="{StaticResource Switch}" Content="Çiftleri grupla" IsChecked="{Binding GroupMode, Mode=TwoWay}"
                          Margin="0,0,14,0" VerticalAlignment="Center"/>
                <CheckBox Style="{StaticResource Switch}" Content="Yalnızca çiftler" IsChecked="{Binding OnlyDuplicates, Mode=TwoWay}"
                          Margin="0,0,14,0" VerticalAlignment="Center"/>
                <CheckBox Style="{StaticResource Switch}" Content="Yol da arama" IsChecked="{Binding SearchPath, Mode=TwoWay}"
                          Margin="0,0,14,0" VerticalAlignment="Center" ToolTip="Kapalıyken yalnızca dosya adında arar"/>
                <CheckBox Style="{StaticResource Switch}" Content="Panodakileri gizle" IsChecked="{Binding HideStaged, Mode=TwoWay}"
                          VerticalAlignment="Center" AutomationProperties.Name="Panodakileri gizle"
                          ToolTip="Panoya alınan dosyalar sonuçlardan çıkar; panodan çıkarınca geri gelir"/>
            </StackPanel>
        </Grid>

        <ProgressBar Grid.Row="3" Height="3" Minimum="0" Maximum="100"
                     Value="{Binding ScanPercent, Mode=OneWay}" IsIndeterminate="{Binding ScanIsIndeterminate}"
                     BorderThickness="0" Background="Transparent" Foreground="{DynamicResource AccentBrush}"
                     Visibility="{Binding IsScanning, Converter={StaticResource BoolVis}}"/>

        <!-- Sonuçlar + silme panosu -->
        <Grid Grid.Row="4" Margin="14,0,14,0">
            <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}"
                    BorderThickness="1" CornerRadius="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Padding="12,8" BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="0,0,0,1">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="3" Height="14" CornerRadius="2" Background="{DynamicResource AccentBrush}"
                                        VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SectionTitle}" FontSize="12.5" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding SectionMeta}" FontSize="11.5" Foreground="{DynamicResource Muted2Brush}"
                                               Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Button Grid.Column="2" Style="{StaticResource LinkButton}" Click="OnStageAllClick"
                                        Foreground="{DynamicResource AccentStrongBrush}" FontSize="11.5"
                                        Visibility="{Binding CanStageAll, Converter={StaticResource BoolVis}}"
                                        ToolTip="Görünen tüm çift gruplarını silme panosuna al">
                                    <TextBlock Text="Tümünü panoya al"/>
                                </Button>
                            </Grid>

                            <!-- Ana ekran çoklu seçimi -->
                            <Grid Margin="11,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource LinkButton}" Click="OnPickAllClick" FontSize="11.5"
                                            AutomationProperties.Name="Tümünü seç" ToolTip="Görünen tüm dosyaları seç">
                                        <TextBlock Text="Tümünü seç" Foreground="{DynamicResource AccentBrush}"/>
                                    </Button>
                                    <TextBlock Text="·" Foreground="{DynamicResource Muted2Brush}" Margin="6,0" VerticalAlignment="Center"/>
                                    <Button Style="{StaticResource LinkButton}" Click="OnPickCopiesClick" FontSize="11.5"
                                            AutomationProperties.Name="Kopyaları seç" ToolTip="Her gruptan bir kopya korunur, fazlalıklar seçilir">
                                        <TextBlock Text="Kopyaları seç" Foreground="{DynamicResource AccentBrush}"/>
                                    </Button>
                                    <StackPanel Orientation="Horizontal" Visibility="{Binding HasPicked, Converter={StaticResource BoolVis}}">
                                        <TextBlock Text="·" Foreground="{DynamicResource Muted2Brush}" Margin="6,0" VerticalAlignment="Center"/>
                                        <Button Style="{StaticResource LinkButton}" Click="OnClearPicksClick" FontSize="11.5"
                                                AutomationProperties.Name="Seçimi temizle">
                                            <TextBlock Text="Seçimi temizle"/>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding PickedText}" FontSize="11.5"
                                           Foreground="{DynamicResource Muted2Brush}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                <StackPanel Grid.Column="2" Orientation="Horizontal"
                                            Visibility="{Binding HasPicked, Converter={StaticResource BoolVis}}">
                                    <Button Style="{StaticResource GhostButton}" Click="OnStagePickedClick" Height="28" Padding="9,0"
                                            IsEnabled="{Binding HasPicked}" Margin="0,0,6,0"
                                            AutomationProperties.Name="Seçilenleri panoya al" ToolTip="Seçili dosyaları silme panosuna aktar">
                                        <TextBlock Text="Panoya al" FontSize="11.5"/>
                                    </Button>
                                    <Button Style="{StaticResource DangerGhostButton}" Click="OnDeletePickedClick" Height="28" Padding="9,0"
                                            IsEnabled="{Binding HasPicked}" Margin="0,0,6,0"
                                            AutomationProperties.Name="Seçilenleri sil" ToolTip="Seçili dosyalar için silme onayı aç">
                                        <TextBlock Text="Sil" FontSize="11.5"/>
                                    </Button>
                                    <Button Style="{StaticResource GhostButton}" Click="OnRenamePickedClick" Height="28" Padding="9,0"
                                            IsEnabled="{Binding HasPicked}"
                                            AutomationProperties.Name="Seçilenleri adlandır" ToolTip="Seçili dosyaları toplu yeniden adlandır">
                                        <TextBlock Text="Adlandır" FontSize="11.5"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="1">
                        <ListBox x:Name="ResultsList" ItemsSource="{Binding Rows}"
                                 ItemTemplateSelector="{StaticResource ResultSelector}"
                                 ItemContainerStyle="{StaticResource ResultItem}"
                                 Foreground="{DynamicResource TextBrush}"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingStackPanel.IsVirtualizing="True"
                                 VirtualizingStackPanel.VirtualizationMode="Recycling"
                                 Padding="6,4,6,8"/>

                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420"
                                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolVis}}">
                            <Border Width="46" Height="46" CornerRadius="12" Background="{DynamicResource EmptyIconBrush}"
                                    BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                                    HorizontalAlignment="Center" Margin="0,0,0,12">
                                <Path Data="{StaticResource GeoSearch}" Stroke="{DynamicResource Muted2Brush}"
                                      StrokeThickness="1.6" Width="19" Height="19" Stretch="Uniform"/>
                            </Border>
                            <TextBlock Text="{Binding EmptyTitle}" FontSize="15" FontWeight="SemiBold"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding EmptyHint}" Foreground="{DynamicResource Muted2Brush}" FontSize="12.5"
                                       TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0" LineHeight="20"/>
                            <StackPanel Visibility="{Binding IsScanning, Converter={StaticResource BoolVis}}"
                                        Width="360" Margin="0,14,0,0">
                                <TextBlock Text="{Binding ScanDetailText}" FontSize="11.5"
                                           Foreground="{DynamicResource InfoStrongBrush}" TextWrapping="Wrap"
                                           TextAlignment="Center" LineHeight="18"/>
                                <ProgressBar Height="6" Minimum="0" Maximum="100" Margin="0,10,0,0"
                                             Value="{Binding ScanPercent, Mode=OneWay}"
                                             IsIndeterminate="{Binding ScanIsIndeterminate}"
                                             BorderThickness="0" Background="{DynamicResource LineSoftBrush}"
                                             Foreground="{DynamicResource AccentBrush}"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                                    <TextBlock Text="Geçen" FontSize="10.5" Foreground="{DynamicResource Muted2Brush}"/>
                                    <TextBlock Text="{Binding ScanElapsedText}" FontSize="10.5"
                                               Foreground="{DynamicResource MutedBrush}" FontFamily="Cascadia Mono, Consolas"
                                               Margin="4,0,10,0"/>
                                    <TextBlock Text="Kalan" FontSize="10.5" Foreground="{DynamicResource Muted2Brush}"/>
                                    <TextBlock Text="{Binding ScanEtaText}" FontSize="10.5"
                                               Foreground="{DynamicResource MutedBrush}" Margin="4,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                            <Button Style="{StaticResource GhostButton}" Content="Konum ekle" Click="OnOpenLocationsClick"
                                    HorizontalAlignment="Center" Margin="0,14,0,0"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- Karartma -->
            <Border Background="{DynamicResource ScrimBrush}" MouseLeftButtonDown="OnScrimClick"
                    Visibility="{Binding BoardOpen, Converter={StaticResource BoolVis}}"/>

            <!-- Silme panosu -->
            <Border x:Name="BoardPanel" Width="464" HorizontalAlignment="Right" Margin="0,8,8,8"
                    Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                    CornerRadius="14" Visibility="{Binding BoardOpen, Converter={StaticResource BoolVis}}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.55" Color="{DynamicResource ShadowColor}"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Padding="14,12" BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="32" Height="32" CornerRadius="9" Background="{DynamicResource DangerIconBrush}" Margin="0,0,10,0">
                                <Path Data="{StaticResource GeoTrash}" Stroke="{DynamicResource DangerSoftBrush}"
                                      StrokeThickness="1.5" Width="15" Height="15" Stretch="Uniform"
                                      StrokeLineJoin="Round"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Silme panosu" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding BoardSub}" FontSize="11.5" Foreground="{DynamicResource Muted2Brush}"
                                           Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource IconButton}" Click="OnCloseBoardClick"
                                    AutomationProperties.Name="Paneli kapat"
                                    ToolTip="Paneli kapat (pano bellekte kalır)">
                                <Path Data="{StaticResource GeoClose}" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.5"
                                      Width="11" Height="11" Stretch="Uniform"/>
                            </Button>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="12,10">
                        <StackPanel>
                            <Border Background="{DynamicResource InfoSurfaceBrush}" BorderBrush="{DynamicResource InfoBorderBrush}" BorderThickness="1" CornerRadius="9"
                                    Padding="9,7" Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource GeoInfo}" Stroke="{DynamicResource InfoStrongBrush}" StrokeThickness="1.4"
                                          Width="12" Height="12" Stretch="Uniform" Margin="0,1,7,0"/>
                                    <TextBlock Text="Panodaki dosyalar bellekte bekler. Tek tek veya toplu seç, kontrol et, sonra onayla."
                                               Foreground="{DynamicResource InfoTextBrush}" FontSize="11.5" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Grid Margin="0,0,0,9" Visibility="{Binding HasQueue, Converter={StaticResource BoolVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource LinkButton}" Click="OnSelectAllBoardClick">
                                        <TextBlock Text="Tümünü seç" Foreground="{DynamicResource AccentBrush}" FontSize="11.5"/>
                                    </Button>
                                    <TextBlock Text="·" Foreground="{DynamicResource Muted2Brush}" Margin="5,0" VerticalAlignment="Center"/>
                                    <Button Style="{StaticResource LinkButton}" Click="OnSelectNoneBoardClick">
                                        <TextBlock Text="Hiçbirini seç" FontSize="11.5"/>
                                    </Button>
                                </StackPanel>
                                <Button Style="{StaticResource LinkButton}" Click="OnClearBoardClick" HorizontalAlignment="Right">
                                    <TextBlock Text="Panoyu temizle" Foreground="{DynamicResource DangerSoftBrush}" FontSize="11.5"/>
                                </Button>
                            </Grid>

                            <StackPanel Visibility="{Binding HasQueue, Converter={StaticResource BoolVis}}">
                                <ItemsControl ItemsSource="{Binding BoardGroups}" ItemTemplate="{StaticResource BoardGroupTemplate}"/>

                                <Border Background="{DynamicResource WarnSurfaceBrush}" BorderBrush="{DynamicResource WarnBorderBrush}" BorderThickness="1" CornerRadius="9"
                                        Padding="9,7" Margin="0,2,0,9"
                                        Visibility="{Binding HasWarning, Converter={StaticResource BoolVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource GeoWarning}" Stroke="{DynamicResource WarnBrush}"
                                              StrokeThickness="1.5" Width="12" Height="12" Stretch="Uniform" Margin="0,1,7,0"/>
                                        <TextBlock Text="{Binding WarningText}" Foreground="{DynamicResource WarnTextBrush}" FontSize="11.5"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                                        CornerRadius="10" Padding="10,8" Margin="0,0,0,9">
                                    <StackPanel>
                                        <RadioButton Style="{StaticResource DarkRadio}" GroupName="delmode"
                                                     IsChecked="{Binding IsRecycle, Mode=TwoWay}">
                                            <StackPanel>
                                                <TextBlock Text="Geri Dönüşüm Kutusu'na taşı" FontSize="12.5"/>
                                                <TextBlock Text="Güvenli · geri alınabilir" FontSize="11"
                                                           Foreground="{DynamicResource Muted2Brush}" Margin="0,1,0,0"/>
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton Style="{StaticResource DarkRadio}" GroupName="delmode"
                                                     IsChecked="{Binding IsPermanent, Mode=TwoWay}" Margin="0,9,0,0">
                                            <StackPanel>
                                                <TextBlock Text="Kalıcı olarak sil" FontSize="12.5"/>
                                                <TextBlock Text="Geri alınamaz · disk alanı hemen boşalır" FontSize="11"
                                                           Foreground="{DynamicResource Muted2Brush}" Margin="0,1,0,0"/>
                                            </StackPanel>
                                        </RadioButton>
                                    </StackPanel>
                                </Border>

                                <Border Background="{DynamicResource InfoSurfaceBrush}" BorderBrush="{DynamicResource InfoBorderBrush}" BorderThickness="1" CornerRadius="9" Padding="9,7">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource GeoInfo}" Stroke="{DynamicResource InfoStrongBrush}" StrokeThickness="1.4"
                                              Width="12" Height="12" Stretch="Uniform" Margin="0,1,7,0"/>
                                        <TextBlock Text="Geri dönüşüm kutusunu boşalttığında disk alanı açılır."
                                                   Foreground="{DynamicResource InfoTextBrush}" FontSize="11.5" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="290"
                                        Margin="0,24,0,16"
                                        Visibility="{Binding BoardEmpty, Converter={StaticResource BoolVis}}">
                                <Border Width="42" Height="42" CornerRadius="11" Background="{DynamicResource EmptyIconBrush}"
                                        BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                                        HorizontalAlignment="Center" Margin="0,0,0,10">
                                    <Path Data="{StaticResource GeoClipboard}" Stroke="{DynamicResource Muted2Brush}"
                                          StrokeThickness="1.4" Width="17" Height="17" Stretch="Uniform"
                                          StrokeLineJoin="Round"/>
                                </Border>
                                <TextBlock Text="Panoda dosya yok" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock Text="Sonuçlardaki çöp kutusuna basarak bir dosyanın tüm kopyalarını panoya al. Onaylayana kadar hiçbir şey silinmez."
                                           Foreground="{DynamicResource Muted2Brush}" FontSize="12" TextWrapping="Wrap"
                                           TextAlignment="Center" Margin="0,6,0,0" LineHeight="19"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="2" Padding="12,10" BorderBrush="{DynamicResource LineSoftBrush}"
                            BorderThickness="0,1,0,0" Background="{DynamicResource FieldBrush}" CornerRadius="0,0,14,14">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="{Binding BoardSelectedText}" FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
                                <TextBlock Text="{Binding BoardBytesText}" FontFamily="Cascadia Mono, Consolas"
                                           FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                            </Grid>
                            <CheckBox Style="{StaticResource DarkCheck}" IsChecked="{Binding Approved, Mode=TwoWay}"
                                      IsEnabled="{Binding HasSelected}" Margin="0,0,0,9">
                                <TextBlock Text="Listeyi kontrol ettim, seçili dosyaları silmeyi onaylıyorum."
                                           FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" MaxWidth="396"/>
                            </CheckBox>
                            <Button Style="{StaticResource PrimaryDangerButton}" Click="OnConfirmDeleteClick"
                                    IsEnabled="{Binding CanConfirm}" Content="{Binding ConfirmText}" Margin="0,0,0,7"/>
                            <Grid>
                                <Button Style="{StaticResource LinkButton}" Click="OnCloseBoardClick" HorizontalAlignment="Left">
                                    <TextBlock Text="Kapat" FontSize="11.5"/>
                                </Button>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Path Data="{StaticResource GeoShield}" Stroke="{DynamicResource GoodBrush}" StrokeThickness="1.4"
                                          Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0"/>
                                    <TextBlock Text="Onayın olmadan hiçbir işlem yapılmaz." FontSize="11"
                                               Foreground="{DynamicResource Muted2Brush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Bildirim -->
            <Border Background="{DynamicResource ElevatedBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="10"
                    Padding="12,8" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,14"
                    Visibility="{Binding ToastVisible, Converter={StaticResource BoolVis}}">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding ToastText}" FontSize="12.5" MaxWidth="560" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"/>
                    <Button Style="{StaticResource LinkButton}" Click="OnToastUndoClick" Margin="14,0,0,0"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Son silmeyi geri al"
                            Visibility="{Binding ToastCanUndo, Converter={StaticResource BoolVis}}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource GeoUndo}" Stroke="{DynamicResource AccentStrongBrush}"
                                  StrokeThickness="1.5" Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0"/>
                            <TextBlock Text="Geri al" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentStrongBrush}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Durum çubuğu -->
        <Border Grid.Row="5" Margin="14,9,14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" ClipToBounds="True">
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                        <Path Data="{StaticResource GeoShield}" Stroke="{DynamicResource GoodBrush}" StrokeThickness="1.4"
                              Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Belge ve medya · sistem dosyaları gizli"
                                   Foreground="{DynamicResource MutedBrush}" FontSize="11" VerticalAlignment="Center"
                                   MaxWidth="240" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                        <Path Data="{StaticResource GeoFolder}" Stroke="{DynamicResource Muted2Brush}" StrokeThickness="1.3"
                              Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding RootsText}" Foreground="{DynamicResource Muted2Brush}" FontSize="11"
                                   VerticalAlignment="Center" MaxWidth="200" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource GeoSpark}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.2"
                              Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
