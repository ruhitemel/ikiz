                    </ScrollViewer>

                    <Border Grid.Row="2" Padding="16,11" Background="{DynamicResource FieldBrush}"
                            BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="0,1,0,0"
                            CornerRadius="0,0,16,16">
                        <Grid>
                            <TextBlock Text="MIT lisansıyla açık kaynak · herkesin kullanımına açık · güncellemeler GitHub Releases'tan"
                                       FontSize="10.5" Foreground="{DynamicResource Muted2Brush}"
                                       VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="250" Margin="0,0,10,0"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource GhostButton}" Content="Paylaşım denetimi"
                                        Click="OnOpenPrivacyClick" Margin="0,0,8,0"
                                        AutomationProperties.Name="Paylaşım denetimini aç"/>
                                <Button Style="{StaticResource GhostButton}" Content="Kapat"
                                        Click="OnAboutCloseClick" HorizontalAlignment="Right"
                                        AutomationProperties.Name="Hakkında penceresini kapat"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Konum ekle: sürücüler ve klasörler -->
        <Grid Grid.RowSpan="6" Panel.ZIndex="60"
              Visibility="{Binding LocationsOpen, Converter={StaticResource BoolVis}}">
            <Border Background="{DynamicResource ScrimBrush}" MouseLeftButtonDown="OnLocationsScrimClick"/>
            <Border Width="620" MaxHeight="720" Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="16"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="34" ShadowDepth="0" Opacity="0.6" Color="#000000"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Padding="16,13" BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid Width="34" Height="34" Margin="0,0,11,0">
                                <Border Width="23" Height="23" CornerRadius="6" Background="{DynamicResource AccentBrush}"
                                        HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                <Border Width="23" Height="23" CornerRadius="6" Background="{DynamicResource LogoSecondBrush}"
                                        BorderBrush="{DynamicResource PanelBrush}" BorderThickness="3"
                                        HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                            </Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Konum ekle" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock Text="Sürücünün tamamını veya belirli bir klasörü tara"
                                           FontSize="11.5" Foreground="{DynamicResource Muted2Brush}" Margin="0,1,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource IconButton}" Click="OnCloseLocationsClick"
                                    AutomationProperties.Name="Konum penceresini kapat" ToolTip="Kapat">
                                <Path Data="{StaticResource GeoClose}" Stroke="{DynamicResource MutedBrush}"
                                      StrokeThickness="1.5" Width="11" Height="11" Stretch="Uniform"/>
                            </Button>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" Padding="18,14" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Background="{DynamicResource InfoSurfaceBrush}" BorderBrush="{DynamicResource InfoBorderBrush}"
                                    BorderThickness="1" CornerRadius="9" Padding="10,8">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource GeoInfo}" Stroke="{DynamicResource InfoStrongBrush}"
                                          StrokeThickness="1.4" Width="12" Height="12" Stretch="Uniform" Margin="0,1,7,0"/>
                                    <TextBlock Text="Yalnızca belge, görsel, ses ve video dosyaları indekslenir. Sistem dosyaları; Windows, Program Files, AppData ve Geri Dönüşüm Kutusu gibi klasörler atlanır."
                                               Foreground="{DynamicResource InfoTextBrush}" FontSize="11.5" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Grid Margin="0,15,0,7">
                                <TextBlock Text="SÜRÜCÜLER" FontSize="10.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Muted2Brush}"/>
                                <Button Style="{StaticResource LinkButton}" Click="OnRefreshDrivesClick"
                                        HorizontalAlignment="Right" AutomationProperties.Name="Sürücüleri yenile">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource GeoRefresh}" Stroke="{DynamicResource AccentStrongBrush}"
                                              StrokeThickness="1.4" Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0"/>
                                        <TextBlock Text="Yenile" FontSize="11.5" Foreground="{DynamicResource AccentStrongBrush}"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <ItemsControl ItemsSource="{Binding Drives}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource LineBrush}"
                                                BorderThickness="1" CornerRadius="9" Padding="10,8" Margin="0,0,0,7">
                                            <CheckBox Style="{StaticResource DarkCheck}" IsChecked="{Binding Selected, Mode=TwoWay}"
                                                      IsEnabled="{Binding IsReady}" VerticalAlignment="Center"
                                                      AutomationProperties.Name="{Binding Path, StringFormat='{}{0} sürücüsünü seç'}">
                                                <StackPanel Margin="7,0,0,0">
                                                    <TextBlock Text="{Binding DisplayName}" FontSize="12.5" FontWeight="SemiBold"/>
                                                    <TextBlock Margin="0,1,0,0" FontSize="11" Foreground="{DynamicResource Muted2Brush}">
                                                        <Run Text="{Binding TypeName, Mode=OneWay}"/>
                                                        <Run Text=" · "/>
                                                        <Run Text="{Binding SizeText, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </CheckBox>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Grid Margin="0,10,0,7">
                                <TextBlock Text="KLASÖR" FontSize="10.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Muted2Brush}" VerticalAlignment="Center"/>
                                <Button Style="{StaticResource GhostButton}" Content="Klasör seç…" Click="OnPickFolderClick"
                                        HorizontalAlignment="Right" AutomationProperties.Name="Taranacak klasör seç"/>
                            </Grid>

                            <TextBlock Text="ŞU AN TARANAN KONUMLAR" FontSize="10.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Muted2Brush}" Margin="0,12,0,7"/>
                            <ItemsControl ItemsSource="{Binding RootItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource Panel2Brush}" BorderBrush="{DynamicResource LineSoftBrush}"
                                                BorderThickness="1" CornerRadius="8" Padding="9,6" Margin="0,0,0,5">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding DisplayName}" FontSize="11.5"
                                                           Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
                                                <Button Grid.Column="1" Style="{StaticResource LinkButton}"
                                                        Content="Kaldır" Click="OnRemoveRootClick" Tag="{Binding Path}"
                                                        AutomationProperties.Name="Konumu kaldır"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="2" Padding="16,11" Background="{DynamicResource FieldBrush}"
                            BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="0,1,0,0"
                            CornerRadius="0,0,16,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding SelectionSummary}" FontSize="11.5"
                                       Foreground="{DynamicResource Muted2Brush}" VerticalAlignment="Center"
                                       TextWrapping="Wrap" Margin="0,0,12,0"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Style="{StaticResource GhostButton}" Content="Vazgeç" Click="OnCloseLocationsClick"
                                        Margin="0,0,8,0" AutomationProperties.Name="Konum eklemeyi iptal et"/>
                                <Button Style="{StaticResource PrimaryButton}" Content="Seçilenleri ekle ve tara"
                                        Click="OnAddSelectedDrivesClick" AutomationProperties.Name="Seçilen konumları tara"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Paylaşım öncesi gizlilik denetimi -->
        <Grid Grid.RowSpan="6" Panel.ZIndex="70"
              Visibility="{Binding PrivacyOpen, Converter={StaticResource BoolVis}}">
            <Border Background="{DynamicResource Panel3Brush}" MouseLeftButtonDown="OnPrivacyScrimClick"/>
            <Border Width="640" MaxHeight="720" Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="16"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="34" ShadowDepth="0" Opacity="0.6" Color="#000000"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Padding="16,13" BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid Width="34" Height="34" Margin="0,0,11,0">
                                <Border Width="23" Height="23" CornerRadius="6" Background="{DynamicResource AccentBrush}"
                                        HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                <Border Width="23" Height="23" CornerRadius="6" Background="{DynamicResource LogoSecondBrush}"
                                        BorderBrush="{DynamicResource PanelBrush}" BorderThickness="3"
                                        HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                            </Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Paylaşım öncesi denetim" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock Text="Kişisel veri olmadan paylaşabilirsin — madde madde kontrol"
                                           FontSize="11.5" Foreground="{DynamicResource Muted2Brush}" Margin="0,1,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource IconButton}" Click="OnClosePrivacyClick"
                                    AutomationProperties.Name="Denetim penceresini kapat" ToolTip="Kapat">
                                <Path Data="{StaticResource GeoClose}" Stroke="{DynamicResource MutedBrush}"
                                      StrokeThickness="1.5" Width="11" Height="11" Stretch="Uniform"/>
                            </Button>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" Padding="18,14" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Background="{DynamicResource InfoSurfaceBrush}" BorderBrush="{DynamicResource InfoBorderBrush}"
                                    BorderThickness="1" CornerRadius="9" Padding="10,8">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource GeoShield}" Stroke="{DynamicResource InfoStrongBrush}"
                                          StrokeThickness="1.4" Width="12" Height="12" Stretch="Uniform" Margin="0,1,7,0"/>
                                    <TextBlock Text="Bu ekran hiçbir dosya adı, kullanıcı adı veya yerel yol göstermez. Ekran görüntüsü alıp paylaşabilirsin."
                                               Foreground="{DynamicResource InfoTextBrush}" FontSize="11.5" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource DangerSurfaceBrush}" BorderBrush="{DynamicResource DangerBorderBrush}"
                                    BorderThickness="1" CornerRadius="9" Padding="10,8"
                                    Margin="0,10,0,0" Visibility="{Binding PrivacyHasWarning, Converter={StaticResource BoolVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource GeoWarning}" Stroke="{DynamicResource DangerBrush}"
                                          StrokeThickness="1.4" Width="12" Height="12" Stretch="Uniform" Margin="0,1,7,0"/>
                                    <TextBlock Text="Uyarı var: paylaşmadan önce işaretli maddeleri kontrol et."
                                               Foreground="{DynamicResource DangerSoftBrush}" FontSize="11.5" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Grid Margin="0,14,0,7">
                                <TextBlock Text="KONTROL SONUÇLARI" FontSize="10.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Muted2Brush}"/>
                                <Button Style="{StaticResource LinkButton}" Click="OnRefreshPrivacyClick"
                                        HorizontalAlignment="Right" AutomationProperties.Name="Denetimi yenile">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource GeoRefresh}" Stroke="{DynamicResource AccentStrongBrush}"
                                              StrokeThickness="1.4" Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0"/>
                                        <TextBlock Text="Yeniden denetle" FontSize="11.5"
                                                   Foreground="{DynamicResource AccentStrongBrush}"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <ItemsControl ItemsSource="{Binding PrivacyItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource LineBrush}"
                                                BorderThickness="1" CornerRadius="9" Padding="10,8" Margin="0,0,0,7">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="5"
                                                        Padding="6,2" Margin="0,1,10,0" VerticalAlignment="Top">
                                                    <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource InfoStrongBrush}"/>
                                                </Border>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Detail}" FontSize="11.5" Foreground="{DynamicResource Muted2Brush}"
                                                               TextWrapping="Wrap" Margin="0,3,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="2" Padding="16,11" Background="{DynamicResource FieldBrush}"
                            BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="0,1,0,0"
                            CornerRadius="0,0,16,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Özet kişisel bilgi içermez; panoya kopyalayıp güvenle paylaşabilirsin."
                                       FontSize="11.5" Foreground="{DynamicResource Muted2Brush}"
                                       VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Style="{StaticResource GhostButton}" Content="Kapat" Click="OnClosePrivacyClick"
                                        Margin="0,0,8,0" AutomationProperties.Name="Denetim penceresini kapat"/>
                                <Button Style="{StaticResource PrimaryButton}" Content="Özeti kopyala"
                                        Click="OnCopyPrivacyClick" AutomationProperties.Name="Denetim özetini kopyala"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
