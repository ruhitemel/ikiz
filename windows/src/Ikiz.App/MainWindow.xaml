        <!-- Yeniden adlandırma -->
        <Grid Grid.RowSpan="6" Panel.ZIndex="40"
              Visibility="{Binding RenameOpen, Converter={StaticResource BoolVis}}">
            <Border Background="{DynamicResource ScrimBrush}" MouseLeftButtonDown="OnRenameScrimClick"/>
            <Border Width="580" MaxHeight="680" Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="16"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="34" ShadowDepth="0" Opacity="0.6" Color="#000000"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Padding="16,13" BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="34" Height="34" CornerRadius="9" Background="{DynamicResource AccentSoftBrush}"
                                    Margin="0,0,11,0">
                                <Path Data="{StaticResource GeoPencil}" Stroke="{DynamicResource AccentStrongBrush}"
                                      StrokeThickness="1.5" Width="15" Height="15" Stretch="Uniform"
                                      StrokeLineJoin="Round"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Adı düzenle" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding RenameSub}" FontSize="11.5"
                                           Foreground="{DynamicResource Muted2Brush}"
                                           TextTrimming="CharacterEllipsis" MaxWidth="430" Margin="0,1,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource IconButton}" Click="OnRenameCloseClick"
                                    AutomationProperties.Name="Yeniden adlandırmayı kapat"
                                    ToolTip="Kapat">
                                <Path Data="{StaticResource GeoClose}" Stroke="{DynamicResource MutedBrush}"
                                      StrokeThickness="1.5" Width="11" Height="11" Stretch="Uniform"/>
                            </Button>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" Padding="16,14" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="KAPSAM" FontSize="10.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Muted2Brush}" Margin="0,0,0,7"/>
                            <Border Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource LineBrush}"
                                    BorderThickness="1" CornerRadius="10" Padding="12,10">
                                <StackPanel>
                                    <RadioButton Style="{StaticResource DarkRadio}" GroupName="renamescope"
                                                 Content="Yalnızca bu dosya"
                                                 IsChecked="{Binding RenameScopeOne, Mode=TwoWay}"/>
                                    <RadioButton Style="{StaticResource DarkRadio}" GroupName="renamescope"
                                                 Content="{Binding RenamePickedLabel}"
                                                 IsChecked="{Binding RenameScopePicked, Mode=TwoWay}"
                                                 IsEnabled="{Binding RenameCanPicked}" Margin="0,9,0,0"
                                                 Visibility="{Binding RenameCanPicked, Converter={StaticResource BoolVis}}"/>
                                    <RadioButton Style="{StaticResource DarkRadio}" GroupName="renamescope"
                                                 Content="{Binding RenameGroupLabel}"
                                                 IsChecked="{Binding RenameScopeGroup, Mode=TwoWay}"
                                                 IsEnabled="{Binding RenameCanGroup}" Margin="0,9,0,0"/>
                                    <RadioButton Style="{StaticResource DarkRadio}" GroupName="renamescope"
                                                 Content="{Binding RenameTypeLabel}"
                                                 IsChecked="{Binding RenameScopeType, Mode=TwoWay}"
                                                 IsEnabled="{Binding RenameCanType}" Margin="0,9,0,0"/>
                                    <RadioButton Style="{StaticResource DarkRadio}" GroupName="renamescope"
                                                 Content="{Binding RenameAllLabel}"
                                                 IsChecked="{Binding RenameScopeAll, Mode=TwoWay}"
                                                 IsEnabled="{Binding RenameCanAll}" Margin="0,9,0,0"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="{Binding RenameInputLabel}" FontSize="11.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MutedBrush}" Margin="0,14,0,7"/>
                            <Border Height="42" Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="9"
                                    Padding="11,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="RenameBox" Style="{StaticResource SearchInput}" FontSize="14.5"
                                             Text="{Binding RenameName, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="Yeni dosya adı"
                                             VerticalAlignment="Center"/>
                                    <Border Grid.Column="1" Background="{DynamicResource Panel2Brush}"
                                            CornerRadius="5" Padding="7,2" Margin="10,0,0,0"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding RenameExtensionHint}" FontSize="11"
                                                   Foreground="{DynamicResource Muted2Brush}"/>
                                    </Border>
                                </Grid>
                            </Border>
                            <TextBlock Text="{Binding RenameError}" Foreground="{DynamicResource DangerSoftBrush}"
                                       FontSize="11.5" TextWrapping="Wrap" Margin="0,6,0,0"
                                       Visibility="{Binding RenameHasError, Converter={StaticResource BoolVis}}"/>

                            <Border Background="{DynamicResource Panel2Brush}" BorderBrush="{DynamicResource LineBrush}"
                                    BorderThickness="1" CornerRadius="10" Padding="11,9" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding RenameSummary}" FontSize="12" FontWeight="SemiBold"/>
                                    <ItemsControl ItemsSource="{Binding RenamePreviewRows}" Margin="0,6,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding OldName}" FontSize="11.5"
                                                               Foreground="{DynamicResource Muted2Brush}"
                                                               TextTrimming="CharacterEllipsis" MaxWidth="320"/>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                                                        <Path Data="M4,10 H16 M12,6 L16,10 L12,14"
                                                              Stroke="{DynamicResource Muted2Brush}" StrokeThickness="1.4"
                                                              Width="10" Height="10" Stretch="Uniform"
                                                              VerticalAlignment="Center" Margin="0,0,7,0"/>
                                                        <TextBlock Text="{Binding NewName}" FontSize="11.5"
                                                                   Foreground="{DynamicResource AccentStrongBrush}"
                                                                   TextTrimming="CharacterEllipsis" MaxWidth="220"/>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{Binding RenamePreviewMore}" FontSize="11"
                                               Foreground="{DynamicResource Muted2Brush}" Margin="0,4,0,0"/>
                                    <TextBlock Text="Yeni adı yazdığında önizleme burada görünür."
                                               FontSize="11" Foreground="{DynamicResource Muted2Brush}"
                                               Visibility="{Binding RenamePreviewEmpty, Converter={StaticResource BoolVis}}"/>
                                </StackPanel>
                            </Border>

                            <CheckBox Style="{StaticResource DarkCheck}" IsChecked="{Binding RenameApproved, Mode=TwoWay}"
                                      Margin="0,12,0,0"
                                      Visibility="{Binding RenameNeedsApproval, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="Toplu yeniden adlandırmayı onaylıyorum."
                                           FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                            </CheckBox>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="2" Padding="14,11" Background="{DynamicResource FieldBrush}"
                            BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="0,1,0,0"
                            CornerRadius="0,0,16,16">
                        <Grid>
                            <TextBlock Text="Uzantı korunur; çakışan adlara (2), (3) eklenir."
                                       FontSize="11" Foreground="{DynamicResource Muted2Brush}"
                                       VerticalAlignment="Center" MaxWidth="300" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource GhostButton}" Content="Vazgeç"
                                        Click="OnRenameCloseClick" Margin="0,0,8,0"/>
                                <Button Style="{StaticResource PrimaryButton}" Click="OnApplyRenameClick"
                                        IsEnabled="{Binding CanApplyRename}"
                                        AutomationProperties.Name="Yeniden adlandır">
                                    <TextBlock Text="Yeniden adlandır"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Doğrudan silme onayı -->
        <Grid Grid.RowSpan="6" Panel.ZIndex="41"
              Visibility="{Binding DeleteOpen, Converter={StaticResource BoolVis}}">
            <Border Background="{DynamicResource ScrimBrush}" MouseLeftButtonDown="OnQuickDeleteScrimClick"/>
            <Border Width="540" MaxHeight="660" Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="16"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="34" ShadowDepth="0" Opacity="0.6" Color="#000000"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Padding="16,13" BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="34" Height="34" CornerRadius="9" Background="{DynamicResource DangerIconBrush}"
                                    Margin="0,0,11,0">
                                <Path Data="{StaticResource GeoTrash}" Stroke="{DynamicResource DangerSoftBrush}"
                                      StrokeThickness="1.5" Width="15" Height="15" Stretch="Uniform"
                                      StrokeLineJoin="Round"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding QuickDeleteTitle}" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding QuickDeleteSub}" FontSize="11.5"
                                           Foreground="{DynamicResource Muted2Brush}"
                                           TextTrimming="CharacterEllipsis" MaxWidth="390" Margin="0,1,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource IconButton}" Click="OnQuickDeleteCloseClick"
                                    AutomationProperties.Name="Silme onayını kapat"
                                    ToolTip="Kapat">
                                <Path Data="{StaticResource GeoClose}" Stroke="{DynamicResource MutedBrush}"
                                      StrokeThickness="1.5" Width="11" Height="11" Stretch="Uniform"/>
                            </Button>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" Padding="16,14" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Background="{DynamicResource InfoSurfaceBrush}" BorderBrush="{DynamicResource InfoBorderBrush}"
                                    BorderThickness="1" CornerRadius="9" Padding="10,8">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource GeoInfo}" Stroke="{DynamicResource InfoStrongBrush}"
                                          StrokeThickness="1.4" Width="12" Height="12" Stretch="Uniform"
                                          Margin="0,1,7,0"/>
                                    <TextBlock Text="{Binding QuickDeleteSummary}" Foreground="{DynamicResource InfoTextBrush}"
                                               FontSize="12" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="KAPSAM" FontSize="10.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Muted2Brush}" Margin="0,14,0,7"/>
                            <Border Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource LineBrush}"
                                    BorderThickness="1" CornerRadius="10" Padding="12,10">
                                <StackPanel>
                                    <RadioButton Style="{StaticResource DarkRadio}" GroupName="quickscope"
                                                 Content="{Binding QuickDeleteOneLabel}"
                                                 IsChecked="{Binding QuickDeleteScopeOne, Mode=TwoWay}"/>
                                    <RadioButton Style="{StaticResource DarkRadio}" GroupName="quickscope"
                                                 Content="{Binding QuickDeletePickedLabel}"
                                                 IsChecked="{Binding QuickDeleteScopePicked, Mode=TwoWay}"
                                                 IsEnabled="{Binding QuickDeleteCanPicked}" Margin="0,9,0,0"
                                                 Visibility="{Binding QuickDeleteCanPicked, Converter={StaticResource BoolVis}}"/>
                                    <RadioButton Style="{StaticResource DarkRadio}" GroupName="quickscope"
                                                 Content="{Binding QuickDeleteOthersLabel}"
                                                 IsChecked="{Binding QuickDeleteScopeOthers, Mode=TwoWay}"
                                                 IsEnabled="{Binding QuickDeleteCanCopies}" Margin="0,9,0,0"/>
                                    <RadioButton Style="{StaticResource DarkRadio}" GroupName="quickscope"
                                                 Content="{Binding QuickDeleteCopiesLabel}"
                                                 IsChecked="{Binding QuickDeleteScopeCopies, Mode=TwoWay}"
                                                 IsEnabled="{Binding QuickDeleteCanCopies}" Margin="0,9,0,0"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="SİLME YÖNTEMİ" FontSize="10.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Muted2Brush}" Margin="0,14,0,7"/>
                            <Border Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource LineBrush}"
                                    BorderThickness="1" CornerRadius="10" Padding="12,10">
                                <StackPanel>
                                    <RadioButton Style="{StaticResource DarkRadio}" GroupName="quickmode"
                                                 IsChecked="{Binding QuickDeleteRecycle, Mode=TwoWay}">
                                        <StackPanel>
                                            <TextBlock Text="Geri Dönüşüm Kutusu'na taşı" FontSize="12.5"/>
                                            <TextBlock Text="Güvenli · geri alınabilir" FontSize="11"
                                                       Foreground="{DynamicResource Muted2Brush}" Margin="0,1,0,0"/>
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource DarkRadio}" GroupName="quickmode"
                                                 IsChecked="{Binding QuickDeletePermanent, Mode=TwoWay}" Margin="0,9,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Kalıcı olarak sil" FontSize="12.5"/>
                                            <TextBlock Text="Geri alınamaz · disk alanı hemen boşalır" FontSize="11"
                                                       Foreground="{DynamicResource Muted2Brush}" Margin="0,1,0,0"/>
                                        </StackPanel>
                                    </RadioButton>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource WarnSurfaceBrush}" BorderBrush="{DynamicResource WarnBorderBrush}"
                                    BorderThickness="1" CornerRadius="9" Padding="9,7" Margin="0,12,0,0"
                                    Visibility="{Binding QuickDeleteHasWarning, Converter={StaticResource BoolVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource GeoWarning}" Stroke="{DynamicResource WarnBrush}"
                                          StrokeThickness="1.5" Width="12" Height="12" Stretch="Uniform"
                                          Margin="0,1,7,0"/>
                                    <TextBlock Text="{Binding QuickDeleteWarning}" Foreground="{DynamicResource WarnTextBrush}"
                                               FontSize="11.5" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <CheckBox Style="{StaticResource DarkCheck}" IsChecked="{Binding QuickDeleteApproved, Mode=TwoWay}"
                                      Margin="0,12,0,0">
                                <TextBlock Text="Dosyanın silinmesini onaylıyorum."
                                           FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                            </CheckBox>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="2" Padding="14,11" Background="{DynamicResource FieldBrush}"
                            BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="0,1,0,0"
                            CornerRadius="0,0,16,16">
                        <Grid>
                            <TextBlock Text="Onayın olmadan hiçbir işlem yapılmaz."
                                       FontSize="11" Foreground="{DynamicResource Muted2Brush}"
                                       VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource GhostButton}" Content="Vazgeç"
                                        Click="OnQuickDeleteCloseClick" Margin="0,0,8,0"/>
                                <Button Style="{StaticResource PrimaryDangerButton}" Click="OnConfirmQuickDeleteClick"
                                        IsEnabled="{Binding CanConfirmQuickDelete}"
                                        Content="{Binding QuickDeleteButtonText}"
                                        AutomationProperties.Name="Silmeyi onayla"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Hakkında -->
        <Grid Grid.RowSpan="6" Panel.ZIndex="50"
              Visibility="{Binding AboutOpen, Converter={StaticResource BoolVis}}">
            <Border Background="{DynamicResource Panel3Brush}" MouseLeftButtonDown="OnAboutScrimClick"/>
            <Border Width="548" MaxHeight="680" Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="16"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="34" ShadowDepth="0" Opacity="0.6" Color="#000000"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Padding="16,13" BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid Width="34" Height="34" Margin="0,0,11,0">
                                <Border Width="23" Height="23" CornerRadius="6" Background="{DynamicResource AccentBrush}"
                                        HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                <Border Width="23" Height="23" CornerRadius="6" Background="{DynamicResource LogoSecondBrush}"
                                        BorderBrush="{DynamicResource PanelBrush}" BorderThickness="3"
                                        HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                            </Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="İkiz" FontSize="15" FontWeight="SemiBold"/>
                                    <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="5"
                                            Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding AppVersion}" FontSize="10.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource InfoStrongBrush}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Hızlı dosya arama ve çift kopya temizleyici"
                                           FontSize="11.5" Foreground="{DynamicResource Muted2Brush}" Margin="0,1,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource IconButton}" Click="OnAboutCloseClick"
                                    AutomationProperties.Name="Hakkında penceresini kapat"
                                    ToolTip="Kapat">
                                <Path Data="{StaticResource GeoClose}" Stroke="{DynamicResource MutedBrush}"
                                      StrokeThickness="1.5" Width="11" Height="11" Stretch="Uniform"/>
                            </Button>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" Padding="18,14" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Background="{DynamicResource InfoSurfaceBrush}" BorderBrush="{DynamicResource InfoBorderBrush}"
                                    BorderThickness="1" CornerRadius="9" Padding="10,8">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource GeoShield}" Stroke="{DynamicResource InfoStrongBrush}"
                                          StrokeThickness="1.4" Width="12" Height="12" Stretch="Uniform" Margin="0,1,7,0"/>
                                    <TextBlock Text="Tüm arama ve silme işlemleri bu cihazda yapılır; dosyaların hiçbir yere gönderilmez."
                                               Foreground="{DynamicResource InfoTextBrush}" FontSize="11.5" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource LineBrush}"
                                    BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,12,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="SÜRÜM" FontSize="10.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Muted2Brush}" Margin="0,0,18,8"/>
                                    <TextBlock Grid.Column="1" Text="{Binding AboutVersionText}" FontSize="12.5"
                                               Margin="0,0,0,8"/>
                                    <TextBlock Grid.Row="1" Text="GELİŞTİRİCİ" FontSize="10.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Muted2Brush}" Margin="0,0,18,8"/>
                                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,8">
                                        <TextBlock Text="{Binding DeveloperCredit}" FontSize="12.5" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding OpenSourceNote}" FontSize="11" Foreground="{DynamicResource AccentStrongBrush}"
                                                   TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <TextBlock Grid.Row="2" Text="LİSANS" FontSize="10.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Muted2Brush}" Margin="0,0,18,8"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding LicenseName}" FontSize="12.5"
                                               Margin="0,0,0,8"/>
                                    <TextBlock Grid.Row="3" Text="KAYNAK KODU" FontSize="10.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Muted2Brush}" Margin="0,0,18,0"/>
                                    <Button Grid.Row="3" Grid.Column="1" Style="{StaticResource LinkButton}"
                                            Click="OnAboutProjectClick" HorizontalAlignment="Left"
                                            AutomationProperties.Name="GitHub proje sayfasını aç">
                                        <TextBlock Text="{Binding RepositoryDisplay}" FontSize="12.5"
                                                   Foreground="{DynamicResource AccentStrongBrush}"/>
                                    </Button>
                                    <TextBlock Grid.Row="4" Text="SORUN BİLDİR" FontSize="10.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Muted2Brush}" Margin="0,6,18,0"/>
                                    <Button Grid.Row="4" Grid.Column="1" Style="{StaticResource LinkButton}"
                                            Click="OnAboutIssuesClick" HorizontalAlignment="Left" Margin="0,6,0,0"
                                            AutomationProperties.Name="GitHub üzerinde sorun bildir">
                                        <TextBlock Text="GitHub Issues" FontSize="12.5"
                                                   Foreground="{DynamicResource AccentStrongBrush}"/>
                                    </Button>
                                </Grid>
                            </Border>

                            <Border Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource LineBrush}"
                                    BorderThickness="1" CornerRadius="10" Padding="12,11" Margin="0,12,0,0">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="GÜNCELLEMELER" FontSize="10.5" FontWeight="SemiBold"
