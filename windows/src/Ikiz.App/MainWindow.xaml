                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding ScanText}" Foreground="{DynamicResource AccentStrongBrush}" FontSize="11"
