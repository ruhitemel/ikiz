<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <StartupObject>Ikiz.App.App</StartupObject>
    <ApplicationIcon>Assets\ikiz.ico</ApplicationIcon>
    <AssemblyName>Ikiz.App</AssemblyName>
    <RootNamespace>Ikiz.App</RootNamespace>
    <Version>1.2.1</Version>
    <Authors>Ikiz contributors</Authors>
    <Product>İkiz</Product>
    <Description>Windows için hızlı dosya arama ve çift kopya temizleyici.</Description>
    <Copyright>Copyright (c) 2026 Ruhi Temel</Copyright>
    <RepositoryUrl>https://github.com/ruhitemel/ikiz</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <SatelliteResourceLanguages>tr;en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- Yayın paketinde hata ayıklama simgesi ve yerel derleme yolu bulunmasın. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ikiz.Core\Ikiz.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
    <Resource Include="Assets\ikiz.ico" />
  </ItemGroup>

</Project>
